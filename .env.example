# Local development only. Copy as .env; never commit a real key.
MODEL_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
# Output-token budget per call (reasoning + visible text); application hard cap: 8192.
MAX_OUTPUT_TOKENS=4096
# Keep reasoning light for voice/chat/document summaries and conserve API credits.
MUSE_REASONING_EFFORT=minimal

# Phase 5 local research (enable only if SearXNG is running locally)
SEARXNG_BASE_URL=http://127.0.0.1:8080
# Explicit allowed HTTPS domains for read_page/browser_page AND search results.
AGENT_ALLOWED_DOMAINS=wikipedia.org,arxiv.org,github.com,docs.python.org,developer.mozilla.org,docs.searxng.org

# Phase 6 opt-in durable checkpointing and saved memories.
# Start infra/memory/compose.yaml first. Legacy in-memory behavior remains if disabled.
MEMORY_ENABLED=false
MEMORY_DATABASE_URL=postgresql://muse_nova:muse_local_dev@127.0.0.1:55432/muse_nova
# Local hash-vector retrieval is lexical, NOT neural semantic memory.

# Restrict LangGraph checkpoint deserialization to approved basic types.
LANGGRAPH_STRICT_MSGPACK=true

# Phase 6.5: RAG-as-a-Service, local-first (works without Docker)
RAG_SQLITE_PATH=./data/rag.sqlite3
RAG_ENABLE_EMBEDDINGS=false
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
