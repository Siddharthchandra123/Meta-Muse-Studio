flowchart TB
    USER[User voice / text / image]
    UI[Next.js client]
    API[FastAPI gateway]
    VOICE[Muse Voice Transcribe API]
    ORCH[LangGraph stateful orchestrator]
    ROUTER{Provider routing policy}
    SPARK[Muse Spark 1.3: default]
    WONDER[Muse Wonder: opt-in escalation]
    GLIMMER[Muse Glimmer: optional local]
    MEM[Memory service]
    DB[(Postgres + pgvector)]
    GATE[Policy / approval gate]
    TOOLS[Tool gateway]
    WEB[Search grounding / citations]
    BROWSER[Isolated Playwright browser]
    APPS[Email / calendar / files]
    TTS[Kokoro TTS]
    OUTPUT[Streaming UI + audio + task status]
    USER --> UI --> API
    UI -. audio relay .-> VOICE
    VOICE --> API
    API --> ORCH
    ORCH --> ROUTER
    ROUTER --> SPARK
    ROUTER --> WONDER
    ROUTER --> GLIMMER
    ORCH <--> MEM
    MEM <--> DB
    ORCH <--> GATE
    GATE <--> TOOLS
    TOOLS --> WEB
    TOOLS --> BROWSER
    TOOLS --> APPS
    ORCH --> TTS --> OUTPUT
    ORCH --> OUTPUT
